            @page {
    size: A4;

    margin-top: 120px;
    margin-bottom: 100px;

    @top-center {
        content: element(header);
    }

    @bottom-left {
        content: element(footer);
    }
}

            div.header {
            padding-top: 10px;
            position: running(header);
            display: block;
            text-align: center;
            margin-bottom: 100px;
            }
            div.footer {
            line-height: 8px;
            position: running(footer);
            display: block;
            }
            
            div.pageNumber {
            position: running(footer);
            text-align: right;
            font-size: 12px;
            <!-- margin-bottom: 40px; -->
            }
            .pagenumber:before {
            content: "Page " counter(page) " of " counter(pages);
            }
            .pagecount:before {
            content: counter(pages);
            }
            
            img.logo {
            width: 100px; 
            height: auto;
            }
            .quotation-heading {<!--
font-family: 'Impact', sans-serif;
font-size: 24px;
text-align: center;
color: #008080; -->
