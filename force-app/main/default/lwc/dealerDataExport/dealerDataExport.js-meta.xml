<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>59.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>Dealer Data Export</masterLabel>
    <description>Reusable date-range Excel export for portal list pages</description>
    <targets>
        <target>lightning__AppPage</target>
        <target>lightning__HomePage</target>
        <target>lightning__RecordPage</target>
        <target>lightningCommunity__Page</target>
        <target>lightningCommunity__Default</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightningCommunity__Default">
            <property name="objectKey" type="String" default="Quote" label="Object Key"
                description="Quote, Order, Lead, Invoice, Contact, Case, Inventory, or Product"/>
            <property name="buttonLabel" type="String" default="Export" label="Button Label"/>
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>