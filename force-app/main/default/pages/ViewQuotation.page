            <!-- border-collapse: collapse;-->
            width: 100%;
            text-align: center;
            }
            .row1{
            width:100%;
            text-align: center;
            line-height: 0px;
            }            
        </style>
        <style>
    .tot-label { 
        text-align: right; 
